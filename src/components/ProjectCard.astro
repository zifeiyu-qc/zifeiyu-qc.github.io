---
import { getTranslations, type Lang } from '../utils/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  tags?: string[];
  href?: string;
  featured?: boolean;
  video?: string;
  poster?: string;
  previewImage?: string;
  mediaLabel?: string;
  mediaPlaceholder?: string;
  showMedia?: boolean;
  preview?: boolean;
  slug?: string;
  status?: string;
  statusTone?: 'complete' | 'ongoing';
}

const {
  lang,
  title,
  description,
  tags = [],
  href,
  featured = false,
  video,
  poster,
  previewImage,
  mediaLabel,
  mediaPlaceholder,
  showMedia = false,
  preview = false,
  slug,
  status,
  statusTone = 'ongoing',
} = Astro.props;
const t = getTranslations(lang);
const cardPreview = previewImage ?? poster;
---

<article id={slug} class:list={['card', 'project-card', { featured, 'has-media': showMedia || preview }] }>
  <div class="card-heading">
    <span class="card-kicker">{featured ? t.common.featuredProject : t.common.project}</span>
    <span class:list={['project-status', `is-${statusTone}`]}>
      <span aria-hidden="true"></span>{status ?? t.common.inProgress}
    </span>
  </div>
  {preview && cardPreview && (
    <img class="project-media project-preview" src={cardPreview} alt={mediaLabel ?? title} width="1672" height="941" loading="lazy" />
  )}
  {showMedia && video && (
    <video class="project-media" controls preload="metadata" playsinline poster={poster} aria-label={mediaLabel ?? title}>
      <source src={video} type="video/mp4" />
    </video>
  )}
  {(showMedia || preview) && !video && !cardPreview && mediaPlaceholder && (
    <div class="project-media project-media-placeholder">
      <span>{mediaPlaceholder}</span>
    </div>
  )}
  <h3>{title}</h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <ul class="tag-list" aria-label={t.common.technologies}>
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
  {href && <a class="card-link" href={href}>{t.common.viewProject} <span aria-hidden="true">→</span></a>}
</article>
