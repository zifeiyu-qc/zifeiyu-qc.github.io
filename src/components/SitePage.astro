---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import LearningCard from './LearningCard.astro';
import { getLocalizedPath, getTranslations, type Lang, type PageKey } from '../utils/i18n';

interface Props { lang: Lang; page: PageKey; }
const { lang, page } = Astro.props;
const t = getTranslations(lang);
const metadata = page === 'home' ? t.home : t[page];
---

<BaseLayout lang={lang} page={page} title={metadata.title} description={'description' in metadata ? metadata.description : undefined}>
  {page === 'home' && (
    <>
      <section class="hero container">
        <div class="hero-copy">
          <div class="hero-profile-content">
            <div class="hero-heading-group">
              <h1>{t.home.name}</h1>
              <div class="hero-education">
                <span class="education-period">{t.home.educationPeriod}</span>
                <div>
                  <p class="education-school">{t.home.educationSchool}</p>
                  <p class="education-role">{t.home.educationRole}</p>
                </div>
              </div>
            </div>
            <ul class="hero-capabilities" aria-label={t.home.capabilitiesAria}>
              {t.home.capabilities.map((item, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <div><small>{item.label}</small><strong>{item.value}</strong></div>
                </li>
              ))}
            </ul>
            <div class="hero-intro">
              <p class="hero-intro-lead">{t.home.introLead}</p>
              <p>{t.home.introDetails}</p>
            </div>
            <div class="button-group" aria-label={t.home.profileLinks}>
              <a class="button" href="https://github.com/zifeiyu-qc" target="_blank" rel="noopener noreferrer">GitHub</a>
              <button
                class="button"
                type="button"
                data-copy-email="3483427116@qq.com"
                data-copy-success={t.home.emailCopied}
                data-copy-failure={t.home.emailCopyFailed}
                aria-label={`${t.home.email}: 3483427116@qq.com`}
              >{t.home.email}</button>
              <a class="button" href={getLocalizedPath(lang, 'projects')}>{t.home.projectsButton}</a>
            </div>
          </div>
          <figure class="hero-portrait">
            <img src="/my_pic.jpg" alt={t.home.portraitAlt} width="1280" height="1706" loading="eager" fetchpriority="high" />
          </figure>
        </div>
        <aside class="research-panel" aria-label={t.home.researchFocusAria}>
          <p class="panel-label research-panel-title">{t.home.researchFocus}</p>
          <div class="focus-visual" aria-hidden="true">
            <svg class="focus-path" viewBox="0 0 100 100" preserveAspectRatio="none">
              <polyline points="18,65 43,30 67,68 88,32"></polyline>
            </svg>
            <span class="node node-one"></span><span class="node node-two"></span><span class="node node-three"></span><span class="node node-four"></span>
          </div>
          <ul class="research-area-list">
            {t.home.researchAreas.map((area, index) => (
              <li>
                <span class="research-area-icon" aria-hidden="true">
                  {index === 0 && <svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4.5 7.8 7.5 4.3 7.5-4.3M12 12.1V21"/></svg>}
                  {index === 1 && <svg viewBox="0 0 24 24"><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M7 6h10M6.5 7.5l4.4 8.7m6.6-8.7-4.4 8.7"/></svg>}
                  {index === 2 && <svg viewBox="0 0 24 24"><circle cx="6" cy="12" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="18" cy="18" r="2"/><path d="m8 11 8-4m-8 6 8 4"/></svg>}
                  {index === 3 && <svg viewBox="0 0 24 24"><path d="M8 4v5l-3 3v4m11-12v5l3 3v4M8 9h8M5 16h4m6 0h4M9 16v4m6-4v4"/></svg>}
                </span>
                <div>
                  <strong>{area.title}</strong>
                  <p>{area.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </aside>
      </section>
      <div class="copy-toast" data-copy-toast role="status" aria-live="polite" hidden></div>
      <section class="section container">
        <div class="section-heading"><div><p class="section-label">{t.home.featuredProjectsLabel}</p><h2>{t.home.featuredProjects}</h2></div><a class="text-link" href={getLocalizedPath(lang, 'projects')}>{t.home.allProjects} <span aria-hidden="true">→</span></a></div>
        <div class="card-grid featured-grid">{t.projects.items.slice(0, 3).map((project) => <ProjectCard lang={lang} featured preview {...project} href={`${getLocalizedPath(lang, 'projects')}#${project.slug}`} />)}</div>
      </section>
      <section class="section container">
        <div class="section-heading"><div><p class="section-label">{t.home.recentLearningLabel}</p><h2>{t.home.recentLearning}</h2></div><a class="text-link" href={getLocalizedPath(lang, 'learning')}>{t.home.allNotes} <span aria-hidden="true">→</span></a></div>
        <div class="card-grid">{t.learning.items.slice().sort((a, b) => b.dateTime.localeCompare(a.dateTime)).slice(0, 2).map((item) => <LearningCard lang={lang} {...item} />)}</div>
      </section>
    </>
  )}

  {page === 'projects' && (
    <><section class="page-intro container"><h1>{t.projects.heading}</h1><p>{t.projects.intro}</p></section><section class="section container" aria-label={t.projects.listAria}><div class="card-grid project-showcase-grid">{t.projects.items.map((project) => <ProjectCard lang={lang} showMedia {...project} />)}</div></section></>
  )}

  {page === 'learning' && (
    <>
      <section class="page-intro learning-intro container">
        <h1>{t.learning.heading}</h1>
        <p>{t.learning.intro}</p>
      </section>
      <section class="section learning-section container" aria-label={t.learning.categoriesAria}>
        <div class="learning-goal-panel">
          <div class="learning-goal-panel-heading">
            <p>{t.learning.tracksLabel}</p>
            <span>{t.learning.orderLabel}</span>
          </div>
          <div class="learning-goal-tabs" role="tablist" aria-label={t.learning.goalsAria} data-learning-tabs>
            <button class="learning-goal-tab" id="learning-tab-all" type="button" role="tab" aria-selected="true" aria-controls="learning-timeline" data-learning-tab="all" data-goal-description={t.learning.allGoalsDescription}>{t.learning.allGoals}</button>
            {t.learning.goals.map((goal) => (
              <button class="learning-goal-tab" id={`learning-tab-${encodeURIComponent(goal.id)}`} type="button" role="tab" aria-selected="false" aria-controls="learning-timeline" tabindex="-1" data-learning-tab={goal.id} data-goal-description={goal.description}>{goal.label}</button>
            ))}
          </div>
          <p class="learning-goal-description" id="learning-goal-description" aria-live="polite" aria-atomic="true">{t.learning.allGoalsDescription}</p>
        </div>
        <div class="learning-list" id="learning-timeline" role="tabpanel" aria-labelledby="learning-tab-all" aria-describedby="learning-goal-description" data-active-goal="all">
          {t.learning.items.map((item) => <LearningCard lang={lang} journal {...item} />)}
        </div>
      </section>
    </>
  )}

  {page === 'publications' && (
    <><section class="page-intro container"><p class="eyebrow">{t.publications.eyebrow}</p><h1>{t.publications.heading}</h1><p>{t.publications.intro}</p></section><section class="section container"><div class="empty-state"><span class="empty-index">{t.publications.index}</span><span class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3.5h7l4 4V20a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z"/><path d="M14 3.5V8h4M9 12h6m-6 4h4"/></svg></span><h2>{t.publications.emptyTitle}</h2><p>{t.publications.emptyText}</p><div class="empty-actions"><a class="button" href={getLocalizedPath(lang, 'projects')}>{t.publications.projectsAction}</a><a class="button" href={getLocalizedPath(lang, 'learning')}>{t.publications.learningAction}</a></div></div></section></>
  )}
</BaseLayout>

<script>
  const fallbackCopy = (text: string) => {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    const copied = document.execCommand('copy');
    textarea.remove();
    if (!copied) throw new Error('Copy command failed');
  };

  let fadeTimer: number | undefined;
  let hideTimer: number | undefined;

  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
    button.addEventListener('click', async () => {
      const email = button.dataset.copyEmail ?? '';
      const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
      if (!toast) return;

      let succeeded = true;
      try {
        if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(email);
        else fallbackCopy(email);
      } catch {
        try { fallbackCopy(email); }
        catch { succeeded = false; }
      }

      toast.textContent = succeeded ? button.dataset.copySuccess ?? '' : button.dataset.copyFailure ?? '';
      window.clearTimeout(fadeTimer);
      window.clearTimeout(hideTimer);
      toast.classList.remove('visible');
      toast.hidden = false;
      requestAnimationFrame(() => {
        const buttonRect = button.getBoundingClientRect();
        const toastRect = toast.getBoundingClientRect();
        const edgeGap = 14;
        const buttonGap = 10;
        const halfToastWidth = toastRect.width / 2;
        const desiredLeft = buttonRect.left + buttonRect.width / 2;
        const left = Math.min(
          window.innerWidth - halfToastWidth - edgeGap,
          Math.max(halfToastWidth + edgeGap, desiredLeft),
        );
        const spaceBelow = window.innerHeight - buttonRect.bottom;
        const top = spaceBelow >= toastRect.height + buttonGap + edgeGap
          ? buttonRect.bottom + buttonGap
          : buttonRect.top - toastRect.height - buttonGap;

        toast.style.left = `${left}px`;
        toast.style.top = `${Math.max(edgeGap, top)}px`;
        toast.classList.add('visible');
      });

      fadeTimer = window.setTimeout(() => toast.classList.remove('visible'), 2700);
      hideTimer = window.setTimeout(() => { toast.hidden = true; }, 3000);
    });
  });

  const learningTabs = document.querySelector<HTMLElement>('[data-learning-tabs]');
  const learningTimeline = document.querySelector<HTMLElement>('#learning-timeline');
  const learningDescription = document.querySelector<HTMLElement>('#learning-goal-description');

  if (learningTabs && learningTimeline) {
    const tabs = [...learningTabs.querySelectorAll<HTMLButtonElement>('[data-learning-tab]')];
    const entries = [...learningTimeline.querySelectorAll<HTMLElement>('[data-learning-entry]')];

    const selectGoal = (selectedTab: HTMLButtonElement) => {
      const goal = selectedTab.dataset.learningTab ?? 'all';
      tabs.forEach((tab) => {
        const selected = tab === selectedTab;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      entries.forEach((entry) => {
        entry.hidden = goal !== 'all' && entry.dataset.learningEntry !== goal;
      });
      learningTimeline.dataset.activeGoal = goal;
      if (learningDescription) learningDescription.textContent = selectedTab.dataset.goalDescription ?? '';
      learningTimeline.setAttribute('aria-labelledby', selectedTab.id);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectGoal(tab));
      tab.addEventListener('keydown', (event) => {
        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = tabs.length - 1;
        else return;

        event.preventDefault();
        tabs[nextIndex].focus();
        selectGoal(tabs[nextIndex]);
      });
    });
  }
</script>
