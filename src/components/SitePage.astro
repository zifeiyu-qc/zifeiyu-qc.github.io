---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import LearningCard from './LearningCard.astro';
import { getLocalizedPath, getTranslations, type Lang, type PageKey } from '../utils/i18n';

interface Props { lang: Lang; page: PageKey; }
const { lang, page } = Astro.props;
const t = getTranslations(lang);
const metadata = page === 'home' ? t.home : t[page];
---

<BaseLayout lang={lang} page={page} title={metadata.title} description={'description' in metadata ? metadata.description : undefined}>
  {page === 'home' && (
    <>
      <section class="hero container">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> {t.home.openToWork}</p>
          <h1>{t.home.name}</h1>
          <p class="panel-label">{t.home.identity}</p>
          <p class="hero-focus">{t.home.focus.map((item, index) => <>{index > 0 && <span>/</span>}{item}</>)}</p>
          <p class="hero-intro">{t.home.intro}</p>
          <div class="button-group" aria-label={t.home.profileLinks}>
            <a class="button" href="https://github.com/zifeiyu-qc" target="_blank" rel="noopener noreferrer">GitHub</a>
            <button
              class="button"
              type="button"
              data-copy-email="3483427116@qq.com"
              data-copy-success={t.home.emailCopied}
              data-copy-failure={t.home.emailCopyFailed}
              aria-label={`${t.home.email}: 3483427116@qq.com`}
            >{t.home.email}</button>
            <a class="button" href={getLocalizedPath(lang, 'projects')}>{t.home.projectsButton}</a>
          </div>
        </div>
        <aside class="research-panel" aria-label={t.home.researchFocusAria}>
          <p class="panel-label">{t.home.researchFocus}</p>
          <div class="focus-visual" aria-hidden="true">
            <svg class="focus-path" viewBox="0 0 100 100" preserveAspectRatio="none">
              <polyline points="18,65 43,30 67,68 88,32"></polyline>
            </svg>
            <span class="node node-one"></span><span class="node node-two"></span><span class="node node-three"></span><span class="node node-four"></span>
          </div>
          <dl>{t.home.researchAreas.map((area, index) => <div><dt>0{index + 1}</dt><dd>{area}</dd></div>)}</dl>
        </aside>
      </section>
      <div class="copy-toast" data-copy-toast role="status" aria-live="polite" hidden></div>
      <section class="section container">
        <div class="section-heading"><div><h2>{t.home.featuredProjects}</h2></div><a class="text-link" href={getLocalizedPath(lang, 'projects')}>{t.home.allProjects} <span aria-hidden="true">→</span></a></div>
        <div class="card-grid featured-grid">{t.projects.items.slice(0, 3).map((project) => <ProjectCard lang={lang} featured {...project} />)}</div>
      </section>
      <section class="section container">
        <div class="section-heading"><div><h2>{t.home.recentLearning}</h2></div><a class="text-link" href={getLocalizedPath(lang, 'learning')}>{t.home.allNotes} <span aria-hidden="true">→</span></a></div>
        <div class="card-grid">{t.learning.items.slice(0, 2).map((item) => <LearningCard lang={lang} {...item} date={t.home.comingSoon} />)}</div>
      </section>
    </>
  )}

  {page === 'projects' && (
    <><section class="page-intro container"><h1>{t.projects.heading}</h1><p>{t.projects.intro}</p></section><section class="section container" aria-label={t.projects.listAria}><div class="card-grid three-column">{t.projects.items.map((project) => <ProjectCard lang={lang} {...project} />)}</div></section></>
  )}

  {page === 'learning' && (
    <><section class="page-intro container"><h1>{t.learning.heading}</h1><p>{t.learning.intro}</p></section><section class="section container" aria-label={t.learning.categoriesAria}><div class="card-grid">{t.learning.items.map((item) => <LearningCard lang={lang} {...item} date={t.learning.comingSoon} />)}</div></section></>
  )}

  {page === 'publications' && (
    <><section class="page-intro container"><p class="eyebrow">{t.publications.eyebrow}</p><h1>{t.publications.heading}</h1><p>{t.publications.intro}</p></section><section class="section container"><div class="empty-state"><span class="empty-index">{t.publications.index}</span><h2>{t.publications.emptyTitle}</h2><p>{t.publications.emptyText}</p></div></section></>
  )}
</BaseLayout>

<script>
  const fallbackCopy = (text: string) => {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    const copied = document.execCommand('copy');
    textarea.remove();
    if (!copied) throw new Error('Copy command failed');
  };

  let fadeTimer: number | undefined;
  let hideTimer: number | undefined;

  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
    button.addEventListener('click', async () => {
      const email = button.dataset.copyEmail ?? '';
      const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
      if (!toast) return;

      let succeeded = true;
      try {
        if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(email);
        else fallbackCopy(email);
      } catch {
        try { fallbackCopy(email); }
        catch { succeeded = false; }
      }

      toast.textContent = succeeded ? button.dataset.copySuccess ?? '' : button.dataset.copyFailure ?? '';
      window.clearTimeout(fadeTimer);
      window.clearTimeout(hideTimer);
      toast.hidden = false;
      requestAnimationFrame(() => toast.classList.add('visible'));

      fadeTimer = window.setTimeout(() => toast.classList.remove('visible'), 2700);
      hideTimer = window.setTimeout(() => { toast.hidden = true; }, 3000);
    });
  });
</script>
