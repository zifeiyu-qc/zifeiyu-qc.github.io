---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import LearningCard from './LearningCard.astro';
import { getLocalizedPath, getTranslations, type Lang, type PageKey } from '../utils/i18n';

interface Props { lang: Lang; page: PageKey; }
const { lang, page } = Astro.props;
const t = getTranslations(lang);
const metadata = page === 'home' ? t.home : t[page];
---

<BaseLayout lang={lang} page={page} title={metadata.title} description={'description' in metadata ? metadata.description : undefined}>
  {page === 'home' && (
    <>
      <section class="hero container">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> {t.home.openToWork}</p>
          <h1>{t.home.name}</h1>
          <p class="panel-label">{t.home.identity}</p>
          <p class="hero-focus">{t.home.focus.map((item, index) => <>{index > 0 && <span>/</span>}{item}</>)}</p>
          <p class="hero-intro">{t.home.intro}</p>
          <div class="button-group" aria-label={t.home.profileLinks}>
            <a class="button primary" href="https://github.com/zifeiyu-qc">GitHub</a>
            <a class="button" href="#">{t.home.resume}</a>
            <a class="button" href="mailto:your-email@example.com">{t.home.email}</a>
            <a class="button" href={getLocalizedPath(lang, 'projects')}>{t.home.projectsButton}</a>
          </div>
        </div>
        <aside class="research-panel" aria-label={t.home.researchFocusAria}>
          <p class="panel-label">{t.home.researchFocus}</p>
          <div class="focus-visual" aria-hidden="true">
            <span class="node node-one"></span><span class="node node-two"></span><span class="node node-three"></span><span class="node node-four"></span>
            <span class="trace trace-one"></span><span class="trace trace-two"></span><span class="trace trace-three"></span>
          </div>
          <dl>{t.home.researchAreas.map((area, index) => <div><dt>0{index + 1}</dt><dd>{area}</dd></div>)}</dl>
        </aside>
      </section>
      <section class="section container">
        <div class="section-heading"><div><p class="eyebrow">{t.home.selectedWork}</p><h2>{t.home.featuredProjects}</h2></div><a class="text-link" href={getLocalizedPath(lang, 'projects')}>{t.home.allProjects} <span aria-hidden="true">→</span></a></div>
        <div class="card-grid featured-grid">{t.projects.items.slice(0, 3).map((project) => <ProjectCard lang={lang} featured {...project} />)}</div>
      </section>
      <section class="section container">
        <div class="section-heading"><div><p class="eyebrow">{t.home.knowledgeLog}</p><h2>{t.home.recentLearning}</h2></div><a class="text-link" href={getLocalizedPath(lang, 'learning')}>{t.home.allNotes} <span aria-hidden="true">→</span></a></div>
        <div class="card-grid">{t.learning.items.slice(0, 2).map((item) => <LearningCard lang={lang} {...item} date={t.home.comingSoon} />)}</div>
      </section>
    </>
  )}

  {page === 'projects' && (
    <><section class="page-intro container"><p class="eyebrow">{t.projects.eyebrow}</p><h1>{t.projects.heading}</h1><p>{t.projects.intro}</p></section><section class="section container" aria-label={t.projects.listAria}><div class="card-grid three-column">{t.projects.items.map((project) => <ProjectCard lang={lang} {...project} />)}</div></section></>
  )}

  {page === 'learning' && (
    <><section class="page-intro container"><p class="eyebrow">{t.learning.eyebrow}</p><h1>{t.learning.heading}</h1><p>{t.learning.intro}</p></section><section class="section container" aria-label={t.learning.categoriesAria}><div class="card-grid">{t.learning.items.map((item) => <LearningCard lang={lang} {...item} date={t.learning.comingSoon} />)}</div></section></>
  )}

  {page === 'publications' && (
    <><section class="page-intro container"><p class="eyebrow">{t.publications.eyebrow}</p><h1>{t.publications.heading}</h1><p>{t.publications.intro}</p></section><section class="section container"><div class="empty-state"><span class="empty-index">{t.publications.index}</span><h2>{t.publications.emptyTitle}</h2><p>{t.publications.emptyText}</p></div></section></>
  )}

  {page === 'about' && (
    <><section class="page-intro container"><p class="eyebrow">{t.about.eyebrow}</p><h1>{t.about.heading}</h1><p>{t.about.intro}</p></section><section class="section container about-grid"><article class="prose-panel"><h2>{t.about.contentTitle}</h2>{t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</article><aside class="detail-list" aria-label={t.about.interestsAria}><p class="panel-label">{t.about.interestsLabel}</p><ul>{t.about.interests.map((interest) => <li>{interest}</li>)}</ul></aside></section></>
  )}
</BaseLayout>
