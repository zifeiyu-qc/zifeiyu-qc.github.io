---
import { getTranslations, type Lang } from '../utils/i18n';

interface Props {
  lang: Lang;
  category: string;
  title: string;
  summary: string;
  date: string;
  dateTime?: string;
  href?: string;
  image?: string;
  images?: readonly { src: string; alt: string }[];
  video?: string;
  videos?: readonly { src: string; alt: string; poster?: string }[];
  media?: readonly (
    | { type: 'image'; src: string; alt: string }
    | { type: 'video'; src: string; alt: string; poster?: string }
  )[];
  poster?: string;
  mediaAlt?: string;
  journal?: boolean;
  goal?: string;
}

const {
  lang,
  category,
  title,
  summary,
  date,
  dateTime,
  href,
  image,
  images,
  video,
  videos,
  media,
  poster,
  mediaAlt,
  journal = false,
  goal,
} = Astro.props;
const t = getTranslations(lang);
const noteImages = images ?? (image ? [{ src: image, alt: mediaAlt ?? title }] : []);
const noteVideos = videos ?? (video ? [{ src: video, alt: mediaAlt ?? title, poster }] : []);
const noteMedia = media ?? [
  ...noteImages.map((item) => ({ ...item, type: 'image' as const })),
  ...noteVideos.map((item) => ({ ...item, type: 'video' as const })),
];
---

<article class:list={['card', 'learning-card', { 'journal-entry': journal }] } data-learning-entry={journal ? goal : undefined}>
  {journal && (
    <div class="learning-date">
      <time datetime={dateTime}>{date}</time>
    </div>
  )}
  <div class="learning-entry-body">
    <div class="card-heading">
      <span class="card-kicker">{category}</span>
      {!journal && <time datetime={dateTime}>{date}</time>}
    </div>
    <h3>{title}</h3>
    <p>{summary}</p>
    {journal && noteMedia.length > 0 && (
      <div class="learning-gallery">
        {noteMedia.map((item) => item.type === 'image' ? (
          <figure class="learning-media-item" tabindex="0">
            <img class="learning-media" src={item.src} alt={item.alt} loading="lazy" />
            <figcaption class="learning-media-caption">{item.alt}</figcaption>
          </figure>
        ) : (
          <figure class="learning-media-item" tabindex="0">
            <video class="learning-media" controls preload="metadata" playsinline poster={item.poster} aria-label={item.alt}>
              <source src={item.src} type="video/mp4" />
            </video>
            <figcaption class="learning-media-caption">{item.alt}</figcaption>
          </figure>
        ))}
      </div>
    )}
    {href && <a class="card-link" href={href}>{t.common.readNote} <span aria-hidden="true">→</span></a>}
  </div>
</article>
